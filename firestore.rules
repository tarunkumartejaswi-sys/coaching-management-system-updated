rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }

    match /users/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      allow create, update, delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin()
                  || (
                    request.auth != null
                    && resource.data.authUid == request.auth.uid
                  );

      allow create, update, delete: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    /* =============================
       FEES
       ============================= */

    match /fees/{studentId} {
      allow read: if isAdmin()
                  || (
                    request.auth != null
                    && get(
                      /databases/$(database)/documents/students/$(studentId)
                    ).data.authUid == request.auth.uid
                  );

      allow create, update, delete: if isAdmin();
    }

    match /fees/{studentId}/months/{monthId} {
      allow read: if isAdmin()
                  || (
                    request.auth != null
                    && get(
                      /databases/$(database)/documents/students/$(studentId)
                    ).data.authUid == request.auth.uid
                  );

      allow create, update, delete: if isAdmin();
    }

    match /attendance/{studentId} {
      allow read: if isAdmin()
                  || (
                    request.auth != null
                    && resource.data.authUid == request.auth.uid
                  );

      allow create, update, delete: if isAdmin();
    }

    match /results/{studentId} {
      allow read: if isAdmin()
                  || (
                    request.auth != null
                    && resource.data.authUid == request.auth.uid
                  );

      allow create, update, delete: if isAdmin();
    }

    match /homework/{homeworkId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
  }
}
