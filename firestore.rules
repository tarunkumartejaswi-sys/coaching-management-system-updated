rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasUserProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return hasUserProfile() &&
        userData().role in ['admin', 'Admin', 'ADMIN'];
    }

    function isCR() {
      return hasUserProfile() && (
        userData().role in ['cr', 'CR', 'Cr', 'class_representative'] ||
        (userData().studentId != null &&
         exists(/databases/$(database)/documents/students/$(userData().studentId)) &&
         get(/databases/$(database)/documents/students/$(userData().studentId)).data.isCR == true)
      );
    }

    function isStudentLike() {
      return hasUserProfile() && userData().role in ['student', 'cr', 'CR', 'Cr', 'class_representative'];
    }

    function individualOwnsStudent(studentId) {
      return isStudentLike() && userData().studentId == studentId;
    }

    function familyOwnsStudent(studentId) {
      return isStudentLike() && userData().accountType == 'family' && studentId in userData().studentIds;
    }

    function ownsStudent(studentId) {
      return individualOwnsStudent(studentId) || familyOwnsStudent(studentId);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /studentDirectory/{studentId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (individualOwnsStudent(studentId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'name', 'photoUrl'
         ]));
    }

    match /students/{studentId} {
      allow read: if isAdmin() || isCR() || ownsStudent(studentId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isCR() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendance'])) ||
        (individualOwnsStudent(studentId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'name', 'fatherName', 'motherName', 'address', 'mobile',
           'dob', 'gender', 'photoUrl'
         ]));
    }

    match /director/{directorId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isCR();
    }

    match /tests/{testId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /attendance/{dateId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isCR();
    }

    match /homework/{homeworkId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isCR();
    }

    match /fees/{studentId} {
      allow read: if isAdmin() || ownsStudent(studentId);
      allow create, update, delete: if isAdmin();
    }

    match /fees/{studentId}/months/{monthId} {
      allow read: if isAdmin() || ownsStudent(studentId);
      allow create, update, delete: if isAdmin();
    }

    match /classFees/{classId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /loginHistory/{eventId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /userSessions/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /crSettings/{settingId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /classRepresentatives/{crId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }


    match /crActivityHistory/{activityId} {
      allow read: if isAdmin() || (isCR() && resource.data.performedByUid == request.auth.uid);
      allow create: if isCR() && request.resource.data.performedByUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /crChangeRequests/{requestId} {
      allow read: if isAdmin() ||
        ((isCR() || (hasUserProfile() && userData().role == 'student')) &&
         resource.data.submittedBy == request.auth.uid);

      allow create: if signedIn() &&
        request.resource.data.submittedBy == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.type in [
          'attendance_update', 'homework_add', 'homework_edit',
          'homework_delete', 'homework_completion', 'cr_application'
        ] &&
        ((isCR() && request.resource.data.type != 'cr_application' &&
          request.resource.data.studentId == userData().studentId) ||
         (hasUserProfile() && userData().role == 'student' &&
          request.resource.data.type == 'cr_application' &&
          request.resource.data.studentId == userData().studentId));

      allow update, delete: if isAdmin();
    }
  }
}
