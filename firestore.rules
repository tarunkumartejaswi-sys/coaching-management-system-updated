rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userRole() {
      return signedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : "";
    }
    function isAdmin() { return signedIn() && userRole() == "admin"; }
    function isCR() { return signedIn() && userRole() == "cr"; }
    function isOwnerStudent(studentId) {
      return signedIn() &&
        get(/databases/$(database)/documents/students/$(studentId)).data.authUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /studentDirectory/{studentId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isOwnerStudent(studentId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name","photoUrl"]));
    }

    match /students/{studentId} {
      allow read: if isAdmin() || isCR() || isOwnerStudent(studentId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isOwnerStudent(studentId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           "name","fatherName","motherName","address","mobile","dob","gender","photoUrl"
         ]));
    }

    match /director/{directorId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /tests/{testId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /attendance/{dateId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /homework/{homeworkId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /fees/{studentId} {
      allow read: if isAdmin() || isOwnerStudent(studentId);
      allow create, update, delete: if isAdmin();
    }

    match /fees/{studentId}/months/{monthId} {
      allow read: if isAdmin() || isOwnerStudent(studentId);
      allow create, update, delete: if isAdmin();
    }

    match /crApplications/{studentId} {
      allow read: if isAdmin() || (signedIn() && (request.auth.uid == resource.data.authUid || request.auth.uid == request.resource.data.authUid));
      allow create: if isAdmin() || (isOwnerStudent(studentId) && request.resource.data.authUid == request.auth.uid);
      allow update: if isAdmin() || (isOwnerStudent(studentId) && request.resource.data.authUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /crRequests/{requestId} {
      allow read: if isAdmin() || (isCR() && resource.data.requestedByUid == request.auth.uid);
      allow create: if isCR() && request.resource.data.requestedByUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
