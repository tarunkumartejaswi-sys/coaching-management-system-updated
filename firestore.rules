rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && userData().role == "admin"; }
    function isCR() { return signedIn() && userData().role == "cr"; }
    function isStudentLike() { return signedIn() && (userData().role == "student" || userData().role == "cr"); }
    function ownsStudent(studentId) { return isStudentLike() && userData().studentId == studentId; }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /studentDirectory/{studentId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (ownsStudent(studentId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           "name", "photoUrl"
         ]));
    }

    match /students/{studentId} {
      allow read: if isAdmin() || ownsStudent(studentId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (ownsStudent(studentId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           "name", "fatherName", "motherName", "address", "mobile",
           "dob", "gender", "photoUrl"
         ]));
    }

    match /director/{directorId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /tests/{testId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /attendance/{dateId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /homework/{homeworkId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /fees/{studentId} {
      allow read: if isAdmin() || ownsStudent(studentId);
      allow create, update, delete: if isAdmin();
    }

    match /fees/{studentId}/months/{monthId} {
      allow read: if isAdmin() || ownsStudent(studentId);
      allow create, update, delete: if isAdmin();
    }

    // CRs submit proposed changes only. Admin approval is required before
    // any attendance/homework record is changed.
    match /crChangeRequests/{requestId} {
      allow read: if isAdmin() ||
        ((isCR() || userData().role == "student") && resource.data.submittedBy == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.submittedBy == request.auth.uid &&
        request.resource.data.status == "pending" &&
        request.resource.data.type in [
          "attendance_update", "homework_add", "homework_edit",
          "homework_delete", "homework_completion", "cr_application"
        ] &&
        ((isCR() && request.resource.data.type != "cr_application" &&
          request.resource.data.studentId == userData().studentId) ||
         (userData().role == "student" && request.resource.data.type == "cr_application" &&
          request.resource.data.studentId == userData().studentId));
      allow update, delete: if isAdmin();
    }
  }
}
